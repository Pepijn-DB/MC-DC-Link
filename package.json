{
	"name": "mc_link",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"check": "biome check",
		"lint": "biome lint",
		"format": "biome format --write",
		"start": "bun run src/index.ts",
		"dev": "bun --watch run src/index.ts",
		"typecheck": "tsc --noEmit",
		"postinstall": "bunx --bun prisma generate",
		"db:up": "docker compose -f compose.dev.yaml up -d",
		"db:down": "docker compose -f compose.dev.yaml down",
		"db:generate": "bunx --bun prisma generate",
		"db:migrate": "bunx --bun prisma migrate dev",
		"db:deploy": "bunx --bun prisma migrate deploy"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/bun": "latest",
		"@types/pg": "^8.23.1",
		"prisma": "7.10.1"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@prisma/adapter-pg": "7.10.1",
		"@prisma/client": "7.10.1",
		"discord.js": "^14.27.0",
		"dotenv": "^18.0.8",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	}
}
